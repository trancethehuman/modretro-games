{
  "schema": 2,
  "title": "Toronto Dispatch original soundtrack",
  "copyright": "2026 Hai Nghiem",
  "license": "MIT",
  "authorship": "All melodies, harmonies, drum patterns, instruments, wave shapes and sound effects were written for Toronto Dispatch. No existing song, jingle, chime or recording was copied or paraphrased; the Toronto flavour comes from general genre idioms (soca and calypso iron and steelpan, reggae offbeats, moody R&B, indie rock), not from any particular work.",
  "notation": {
    "channels": "lead = CH2 pulse (never used by effects), counter = CH1 pulse (event cues and engine revs briefly take it), bass = CH3 wave, drums = CH4 noise (braking and impacts briefly take it).",
    "bars": "Each section is four bars of 16 rows (sixteenth notes). Give 1, 2 or 4 bar strings (repeated to four), \"@section\" to reuse another section's channel, or omit the channel for silence.",
    "tokens": "NOTE (C5, Fs4, Bb3; hUGE names: pulse sounds an octave lower, wave two octaves lower), a drum letter, '.' continue or '!' cut. Append :XYZ for a hUGE effect (0xy arpeggio, 3xx slide, 4xy vibrato, Cxx volume...), + to keep that effect on the token's rows and on following bare '.' rows, and /n to fill n rows. <name> switches the channel's instrument.",
    "loop": "A song loops to order `loop` (default 0) through a position jump the generator adds on its last row."
  },
  "songs": [
    {"slug": "title"},
    {"slug": "day"},
    {"slug": "night"},
    {"slug": "chase"}
  ],
