        {
          "speaker": "DRIVER",
          "portrait": "june",
          "lines": [
            "MY ROOM RENT IS DUE.",
            "I KNOW NO ONE HERE.",
            "WHAT IF I GET LOST?",
            "THIS CITY IS HUGE."
          ]
        },
        {
          "speaker": "JUNE",
          "portrait": "june",
          "lines": [
            "FOLLOW THE ROAD CUE.",
            "ONE JOB AT A TIME.",
            "SELECT COLLECTS LOAD",
            "START OPENS THE MENU"
          ]
        },
        {
          "speaker": "JUNE",
          "portrait": "june",
          "lines": [
            "BRAKE BEFORE TURNS.",
            "THE CITY HAS PEOPLE.",
            "BRING THEM HOME SAFE",
            "WE BUILD TRUST HERE."
          ]
        },
        {
          "speaker": "DRIVER",
          "portrait": "june",
          "lines": [
            "JUST ONE GOOD SHIFT.",
            "THEN ANOTHER.",
            "MAYBE THIS PLACE",
            "CAN BECOME MY HOME."
          ]
        }
      ]
    },
    {
