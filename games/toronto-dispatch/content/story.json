        {
          "speaker": "JUNE",
          "portrait": "june",
          "lines": [
            "THAT IS THE START.",
            "MOSS RUNS A GARAGE.",
            "HE KNOWS ENGINES.",
            "HE NEEDS A FRIEND."
          ]
        }
      ]
