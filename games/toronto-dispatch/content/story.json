        {
          "speaker": "DRIVER",
          "portrait": "june",
          "lines": [
            "ONE BAG. A NEW CITY.",
            "A BORROWED CAR.",
            "THIRTY DOLLARS LEFT.",
            "I NEED A FIRST SHIFT"
