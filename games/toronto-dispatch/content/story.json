        {
          "speaker": "JUNE",
          "portrait": "june",
          "lines": [
            "YOU EARNED THAT PAY.",
            "KEEP YOUR RECEIPTS.",
            "TAKE THE NEXT JOB",
            "WHEN YOU ARE READY."
          ]
        },
        {
          "speaker": "DRIVER",
          "portrait": "june",
          "lines": [
            "I CAN LEARN THE CITY",
            "A STREET AT A TIME.",
            "A PERSON AT A TIME.",
            "NO NEED TO RUSH IT."
